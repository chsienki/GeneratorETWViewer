<Window x:Class="GeneratorETWViewer.Views.DetailedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeneratorETWViewer"
        xmlns:converters="clr-namespace:GeneratorETWViewer.Converters"
        xmlns:vm="clr-namespace:GeneratorETWViewer.ViewModels"
        xmlns:models="clr-namespace:GeneratorETWViewer.Models"
        xmlns:controls="clr-namespace:GeneratorETWViewer.Controls"
        xmlns:commands="clr-namespace:GeneratorETWViewer.Command"
        d:DataContext="{d:DesignInstance Type=vm:DetailedExecutionViewModel}"
        mc:Ignorable="d"
        Height="400" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:NullToRowHeightConverter x:Key="NullToRowHeightConverter" />
            <converters:StringJoinConverter x:Key="StringJoinConverter" />

            <commands:OpenCPUStacksCommand x:Key="OpenCPUStacksCommand" />
        </ResourceDictionary>
    </Window.Resources>
    <Window.Title>
        <MultiBinding>
            <MultiBinding.Bindings>
                <Binding Path="ProcessName" />
                <Binding Path="GeneratorName" />
            </MultiBinding.Bindings>
            <MultiBinding.Converter>
                <converters:WindowTitleConverter />
            </MultiBinding.Converter>
        </MultiBinding>
    </Window.Title>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />

        </Grid.ColumnDefinitions>

        <TreeView ItemsSource="{Binding Outputs}" Grid.Column="0" SelectedItemChanged="TreeView_SelectedItemChanged" Tag="{Binding SelectTransformCommand}" >
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:TransformViewModel}" ItemsSource="{Binding Inputs}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true}" >
                            <TextBlock Text="{Binding Path=Name}" />
                            <TextBlock Text=" (" />
                            <TextBlock Text="{Binding Path=DurationInclusive}" />
                            <TextBlock Text="ms)" />
                    
                            <!--<Button />-->
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open CPU Stacks" Command="{StaticResource OpenCPUStacksCommand}" CommandParameter="{Binding EventTime}" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                        </StackPanel>
                        <TextBlock Text="{Binding Path=Name}" Foreground="Gainsboro" Visibility="{Binding IsCached, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=false}" />
                    </Grid>
                </HierarchicalDataTemplate>

            </TreeView.Resources>
        </TreeView>

        <Grid Grid.Column="1" DataContext="{Binding SelectedModel}">
            <StackPanel>
                <TextBlock Text="Name:" FontWeight="Bold" />
                <TextBlock Text="{Binding Name}" />
                
                <TextBlock Text="Type:" FontWeight="Bold" />
                <TextBlock Text="{Binding Type}" />
                
                <TextBlock Text="Previous States:" FontWeight="Bold" />
                <TextBlock Text="{Binding PreviousStates}" />
                
                <TextBlock Text="New States:" FontWeight="Bold" />
                <TextBlock Text="{Binding NewStates}" />

                <TextBlock Text="Duration:" FontWeight="Bold" />
                <TextBlock Text="{Binding Duration, StringFormat=G}" />
            </StackPanel>
        </Grid>

    </Grid>


</Window>